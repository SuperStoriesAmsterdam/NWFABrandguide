# Copy to .env (gitignored) and fill in. These live ONLY on the server, never in the frontend.

# Airtable personal access token with data.records:write on the base.
AIRTABLE_TOKEN=
# The base id (starts with "app...").
AIRTABLE_BASE_ID=
# Table name that holds the submissions.
AIRTABLE_TABLE=Vermeldingen

# Only accept the form POST from the live site origin (tighten this in production).
ALLOW_ORIGIN=https://naturalwinefestival.nl

# Optional: pull the registry (token hashes) live from the deployed file so new venues
# work without redeploying this service. Leave empty to use the baked-in registry.js.
REGISTRY_URL=https://naturalwinefestival.nl/natuurwijn-kaart/vermelding/registry.js

# Port the service listens on (Coolify maps this).
PORT=8788
